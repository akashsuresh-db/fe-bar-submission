# Databricks App — FastAPI backend + prebuilt React frontend (app/backend/static).
# Runtime config lives in app/app.yaml; resource IDs are injected from here.
resources:
  apps:
    fna_control_tower_app:
      name: "cfo-fna-control-tower-${bundle.target}"
      description: "Finance & Accounting Ops Control Tower"
      source_code_path: ../app
      resources:
        - name: sql-warehouse
          description: SQL warehouse used by the app for Genie / SQL queries
          sql_warehouse:
            id: ${var.warehouse_id}
            permission: CAN_USE
        - name: claude-endpoint
          description: Foundation-model serving endpoint (routed via AI Gateway)
          serving_endpoint:
            name: databricks-claude-sonnet-4-5
            permission: CAN_QUERY
        - name: finance-ops-db
          description: Lakebase (managed Postgres) instance for app state
          database:
            instance_name: ${var.lakebase_instance_name}
            database_name: finance_ops_app
            permission: CAN_CONNECT_AND_CREATE
